import capos.*

  test "cambio el poder base de rolando" {
    rolando.poderBase(10)
    assert.equals(10, rolando.poderBase())
  }

describe "poder de artefactos" {
  test "poder base de la espada sin usar es el esperado"{
        rolando.poderBase(10)
        assert.equals(rolando.poderBase(), espada.poderDePelea(rolando))
  }

  test "poder base de la espada usada es el esperado"{
        rolando.poderBase(10)
        espada.usar(rolando)
        assert.equals(rolando.poderBase()/2, espada.poderDePelea(rolando))
  }

  test "poder base de la armadura sin usar es el esperado"{
    assert.equals(6, armadura.poderDePelea(rolando))
  }

  test "poder base de la armadura no cambia al usarla"{
    assert.equals(6, armadura.poderDePelea(rolando))
    armadura.usar(rolando)
    assert.equals(6, armadura.poderDePelea(rolando))
  }

  test "poder del collar con personaje con poder base menor a 6 esperado"{
    rolando.poderBase(5)
    assert.equals(3, collar.poderDePelea(rolando))
  }

    test "poder del collar con personaje con poder base 6 esperado"{
    rolando.poderBase(6)
    assert.equals(3, collar.poderDePelea(rolando))
  }

    test "poder del collar con personaje con poder base mayor a 6 sin usar esperado"{
    rolando.poderBase(7)
    assert.equals(3, collar.poderDePelea(rolando))
  }

    test "poder del collar con personaje con poder base mayor a 6 esperado luego de un uso"{
    rolando.poderBase(7)
    collar.usar(rolando)
    assert.equals(4, collar.poderDePelea(rolando))
  }

    test "poder del collar con personaje con poder base mayor a 6 esperado luego de 3 usos"{
    rolando.poderBase(7)
    collar.usar(rolando)
    collar.usar(rolando)
    collar.usar(rolando)
    assert.equals(6, collar.poderDePelea(rolando))
  }
}

describe "ronaldo en batalla"{
    test "Aumenta el poder base de rolando"{
        rolando.poderBase(0)
        rolando.batalla()
        assert.equals(1, rolando.poderBase())
    }
    test "poder de artefactos cambian si estan en la mochila de ronaldo"{
        rolando.poderBase(8)
        rolando.encontrar(espada)
        rolando.batalla()
        assert.equals(rolando.poderBase()/2, espada.poderDePelea(rolando))
    }
    test "poder de artefactos no cambian si no estan en la mochila de ronaldo"{
        rolando.poderBase(10)
        rolando.encontrar(armadura)
        rolando.batalla()
        rolando.batalla()
        rolando.batalla()
        rolando.batalla()
        rolando.batalla()
        assert.equals(rolando.poderBase(), espada.poderDePelea(rolando))
        assert.equals(3, collar.poderDePelea(rolando))
    }
}
describe "comportamiento con varios artefactos" {
    method initialize(){
        assert.equals(5, rolando.poderBase())
        rolando.capacidad(3)
        rolando.encontrar(espada)
        rolando.encontrar(armadura)
        rolando.encontrar(collar)
        assert.equals(5, espada.poderDePelea(rolando))
        assert.equals(6, armadura.poderDePelea(rolando))
        assert.equals(3, collar.poderDePelea(rolando))
    }
    test "calculo de poder de pelea"{
        assert.equals(19, rolando.poderDePelea())
    }

    test "batallas"{
        rolando.batalla()
        assert.equals(6, rolando.poderBase())
        assert.equals(3, espada.poderDePelea(rolando))
        assert.equals(6, armadura.poderDePelea(rolando))
        rolando.batalla()
        assert.equals(7, rolando.poderBase())
        assert.equals(3.5, espada.poderDePelea(rolando))
        assert.equals(6, armadura.poderDePelea(rolando))
        assert.equals(5, collar.poderDePelea(rolando))
        rolando.batalla()
        assert.equals(8, rolando.poderBase())
        assert.equals(4, espada.poderDePelea(rolando))
        assert.equals(6, armadura.poderDePelea(rolando))
        assert.equals(6, collar.poderDePelea(rolando))

    }
}

