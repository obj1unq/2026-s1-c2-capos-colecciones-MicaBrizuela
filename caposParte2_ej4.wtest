// caposParte2_ej4.wtest
import capos.*

describe "enemigos"{
    method initialize(){
        assert.equals(5, rolando.poderBase())
        rolando.capacidad(3)
        rolando.encontrar(espada)
        rolando.encontrar(armadura)
        rolando.encontrar(collar)
    }

    test "rolando tiene poder de pelea = 19, no vence a todos"{
        assert.notThat(rolando.esPoderoso(erethia))
    }

    test "rolando tiene poder de pelea = 29, vence a todos"{
        rolando.poderBase(10)
        assert.that(rolando.esPoderoso(erethia))
    }
}